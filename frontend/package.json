{
  "name": "rlbyhand-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "node scripts/lint.mjs",
    "check:layout": "python scripts/check-layout.py",
    "check": "npm run lint && npm run build && npm run check:layout",
    "build": "tsc -b && vite build",
    "build:backend": "tsc -b && vite build --outDir ../backend/llm_rl_lab/static --emptyOutDir",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/long-cang": "^5.2.7",
    "@fontsource/patrick-hand": "^5.2.8",
    "katex": "^0.16.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@types/katex": "^0.16.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
